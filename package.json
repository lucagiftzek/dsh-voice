{
  "name": "dsh-voice",
  "version": "2.1.0",
  "description": "Read-aloud, dictation and language-aware speech for the DeepSeek Harness web UI: many TTS/STT providers at once (EU vendors first: Mistral, Speechmatics, Gladia, ReadSpeaker; plus ElevenLabs, Azure, Google, Amazon, OpenAI, OpenRouter and OpenAI-compatible servers, Deepgram, Cartesia, AssemblyAI, Fish, self-hosted Piper/XTTS/Kokoro, the browser voice), per-language routing, in-text language markers, speech annotations (tone, pace, pitch, sounds) adapted to each model, and word highlighting.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/PROVIDERS.md",
    "docs/TROUBLESHOOTING.md",
    "docs/ERRORS.md",
    "skills",
    "docs/TOOLS.md",
    "docs/HISTORY-1.x.md",
    "docs/media",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node scripts/build.mjs --check && node scripts/gen-provider-docs.mjs --check && node --test \"test/**/*.test.mjs\"",
    "docs": "node scripts/gen-provider-docs.mjs --write",
    "privacy": "node scripts/privacy-check.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "author": {
    "name": "Loukas \"Luca\" Tzekos",
    "url": "https://jobopportunitiesapi.org"
  }
}
